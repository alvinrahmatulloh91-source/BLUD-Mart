---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UnitHeader from "@/components/UnitHeader.astro";
import Link from "@/components/Link.astro";
import { icon } from "@/components/icons";
import { getUnitBySlug, getUnitProducts, getUnitServices } from "@/lib/data/units";
import { formatRupiah } from "@/lib/utils";

const { unitSlug } = Astro.params;

const unit = unitSlug ? await getUnitBySlug(unitSlug) : null;

if (!unit) {
  return Astro.redirect("/blud/unit");
}

const [products, services] = await Promise.all([
  getUnitProducts(unit.id),
  getUnitServices(unit.id),
]);
---

<BaseLayout title={`${unit.name} - SKANSABA BLUD-MART`} description={unit.description ?? undefined}>
  <UnitHeader unitSlug={unit.slug} unitName={unit.name} hasServices={services.length > 0} />

  <!-- Hero -->
  <section class="py-16 bg-gradient-to-br from-primary/5 to-secondary/5">
    <div class="container text-center">
      {
        unit.category && (
          <span class="text-sm font-medium px-3 py-1 rounded-full bg-secondary/10 text-secondary mb-4 inline-block">
            {unit.category}
          </span>
        )
      }
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-primary">{unit.name}</h1>
      <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">
        {unit.description}
      </p>
      <div class="flex justify-center gap-4">
        <Link
          href={`/blud/${unit.slug}/katalog`}
          class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary/90 transition-colors"
        >
          Lihat Katalog
          <Fragment set:html={icon("arrow-right", "h-4 w-4")} />
        </Link>
        {
          services.length > 0 && (
            <Link
              href={`/blud/${unit.slug}/layanan`}
              class="inline-flex items-center gap-2 border border-primary text-primary px-6 py-3 rounded-lg font-medium hover:bg-primary/5 transition-colors"
            >
              Pesan Layanan
            </Link>
          )
        }
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  {
    services.length > 0 && (
      <section class="py-16">
        <div class="container">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
            <Fragment set:html={icon("wrench", "h-6 w-6 text-secondary")} />
            Layanan Unggulan
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {services.map((service) => (
              <div class="p-6 rounded-xl border bg-card hover:shadow-md transition-all">
                <h3 class="font-semibold text-lg mb-2">{service.name}</h3>
                {service.priceFrom !== null && (
                  <p class="text-secondary font-medium">
                    Mulai {formatRupiah(service.priceFrom)}
                  </p>
                )}
                {service.duration && (
                  <p class="text-sm text-muted-foreground mt-1">{service.duration}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Products Preview -->
  {
    products.length > 0 && (
      <section class="py-16 bg-muted/50">
        <div class="container">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
            <Fragment set:html={icon("package", "h-6 w-6 text-secondary")} />
            Produk Unggulan
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {products.map((product) => (
              <div class="p-6 rounded-xl border bg-card hover:shadow-md transition-all">
                <div class="h-32 bg-muted rounded-lg mb-4 flex items-center justify-center">
                  <Fragment set:html={icon("image", "h-8 w-8 text-muted-foreground")} />
                </div>
                <h3 class="font-semibold mb-2">{product.name}</h3>
                <p class="text-secondary font-medium">{formatRupiah(product.price)}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Contact CTA -->
  <section class="py-16">
    <div class="container text-center">
      <h2 class="text-2xl font-bold mb-4">Tertarik untuk memesan?</h2>
      <p class="text-muted-foreground mb-8">
        Hubungi kami atau kunjungi katalog untuk melihat semua layanan dan produk.
      </p>
      <Link
        href={`/blud/${unit.slug}/kontak`}
        class="inline-flex items-center gap-2 bg-secondary text-white px-6 py-3 rounded-lg font-medium hover:bg-secondary/90 transition-colors"
      >
        <Fragment set:html={icon("mail", "h-4 w-4")} />
        Hubungi Kami
      </Link>
    </div>
  </section>

  <footer class="border-t py-8 bg-muted/50">
    <div class="container text-center text-sm text-muted-foreground">
      © {new Date().getFullYear()} {unit.name} - SKANSABA BLUD-MART
    </div>
  </footer>
</BaseLayout>
