---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BludHeader from "@/components/BludHeader.astro";
import BludFooter from "@/components/BludFooter.astro";
import Link from "@/components/Link.astro";
import { icon } from "@/components/icons";
import { getStudentWorks } from "@/lib/data/student-works";

const works = await getStudentWorks();
---

<BaseLayout title="Karya Siswa - SKANSABA BLUD-MART">
  <BludHeader />

  <main class="py-12">
    <div class="container">
      <Link href="/blud" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary mb-8">
        <Fragment set:html={icon("arrow-left", "h-4 w-4")} />
        Kembali ke Beranda BLUD
      </Link>

      <div class="mb-12">
        <h1 class="text-4xl font-bold mb-4 text-primary">Karya Siswa</h1>
        <p class="text-xl text-muted-foreground max-w-3xl">
          Portofolio dan karya inovatif siswa SMKN 1 Bantul dari berbagai program
          keahlian dan unit produksi.
        </p>
      </div>

      {
        works.length === 0 ? (
          <div class="text-center py-12">
            <Fragment set:html={icon("award", "h-16 w-16 text-muted-foreground mx-auto mb-4")} />
            <h3 class="text-xl font-semibold mb-2">Belum ada karya siswa</h3>
            <p class="text-muted-foreground">
              Karya siswa akan ditampilkan di sini setelah ditambahkan.
            </p>
          </div>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {works.map((karya) => (
              <div class="rounded-xl border bg-card overflow-hidden hover:shadow-lg transition-all flex flex-col">
                <div class="h-48 bg-muted flex items-center justify-center">
                  <Fragment set:html={icon("award", "h-16 w-16 text-muted-foreground")} />
                </div>
                <div class="p-6 flex-1">
                  <div class="flex items-center gap-2 mb-3">
                    {karya.major && (
                      <span class="text-xs font-medium px-2 py-1 rounded-full bg-primary/10 text-primary">
                        {karya.major}
                      </span>
                    )}
                    {karya.year && (
                      <span class="text-xs text-muted-foreground flex items-center gap-1">
                        <Fragment set:html={icon("calendar", "h-3 w-3")} />
                        {karya.year}
                      </span>
                    )}
                  </div>
                  <h3 class="font-semibold text-lg mb-2">{karya.title}</h3>
                  <p class="text-sm text-muted-foreground mb-4 line-clamp-2 flex-1">
                    {karya.description}
                  </p>
                  <div class="flex items-center justify-between text-xs text-muted-foreground mb-4">
                    {karya.studentTeam && (
                      <span class="flex items-center gap-1">
                        <Fragment set:html={icon("user", "h-3 w-3")} />
                        {karya.studentTeam}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </main>

  <BludFooter />
</BaseLayout>
