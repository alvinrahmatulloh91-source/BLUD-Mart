---
import BaseLayout from "@/layouts/BaseLayout.astro";
import UnitHeader from "@/components/UnitHeader.astro";
import { icon } from "@/components/icons";
import { getUnitBySlug, getUnitProducts } from "@/lib/data/units";
import { formatRupiah } from "@/lib/utils";

const { unitSlug } = Astro.params;
const unit = unitSlug ? await getUnitBySlug(unitSlug) : null;
if (!unit) return Astro.redirect("/blud/unit");

const products = await getUnitProducts(unit.id);
---

<BaseLayout title={`Katalog ${unit.name} - SKANSABA BLUD-MART`}>
  <UnitHeader unitSlug={unit.slug} unitName={unit.name} />

  <main class="py-12">
    <div class="container">
      <h1 class="text-3xl font-bold mb-2">Katalog Produk</h1>
      <p class="text-muted-foreground mb-8">Semua produk yang dijual oleh {unit.name}.</p>

      {
        products.length === 0 ? (
          <div class="text-center py-12 border rounded-xl bg-card">
            <Fragment set:html={icon("package", "h-12 w-12 text-muted-foreground mx-auto mb-4")} />
            <h3 class="font-semibold mb-2">Belum ada produk</h3>
            <p class="text-sm text-muted-foreground">Produk akan segera hadir.</p>
          </div>
        ) : (
          <div class="grid md:grid-cols-3 gap-6">
            {products.map((product) => (
              <div class="rounded-xl border bg-card overflow-hidden hover:shadow-md transition-all">
                <div class="h-40 bg-muted flex items-center justify-center">
                  <Fragment set:html={icon("image", "h-10 w-10 text-muted-foreground")} />
                </div>
                <div class="p-6">
                  {product.estimatedDuration && (
                    <span class="text-xs text-muted-foreground">{product.estimatedDuration}</span>
                  )}
                  <h3 class="font-semibold mb-2">{product.name}</h3>
                  <p class="text-sm text-muted-foreground mb-3 line-clamp-2">{product.description}</p>
                  <p class="text-secondary font-bold">{formatRupiah(product.price)}</p>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </main>

  <footer class="border-t py-8 bg-muted/50">
    <div class="container text-center text-sm text-muted-foreground">
      © {new Date().getFullYear()} {unit.name} - SKANSABA BLUD-MART
    </div>
  </footer>
</BaseLayout>
