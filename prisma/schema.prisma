// This is your Prisma schema file for SKANSABA BLUD-MART
// SMKN 1 BANTUL - Platform BLUD

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  BLUD_ADMIN
  UNIT_ADMIN
  CUSTOMER
}

enum ProductType {
  PRODUCT
  SERVICE
  DIGITAL_SERVICE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password
  role          Role      @default(CUSTOMER)
  unitId        String?   // For UNIT_ADMIN role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  
  // Relations
  orders        Order[]
  cart          Cart?
  unit          Unit? // If this user is admin of a unit
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// SCHOOL BASE WEBSITE
// ============================================

model SchoolPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?  @db.Text
  excerpt     String?
  featuredImage String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SchoolNews {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?  @db.Text
  excerpt     String?
  featuredImage String?
  authorId    String?
  publishedAt DateTime?
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SchoolEvent {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  featuredImage String?
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// BLUD & UNIT PRODUCTION
// ============================================

model Unit {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  category    String?
  logo        String?
  coverImage  String?
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  admin       User?           @relation(fields: [adminId], references: [id])
  adminId     String?         @unique
  
  members     UnitMember[]
  products    Product[]
  services    Service[]
  portfolios  Portfolio[]
  studentWorks StudentWork[]
  orders      Order[]
  cartItems   CartItem[]
}

model UnitMember {
  id        String   @id @default(cuid())
  unitId    String
  userId    String
  role      String   // admin, member, student
  joinedAt  DateTime @default(now())
  
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([unitId, userId])
}

// ============================================
// PRODUCTS & SERVICES
// ============================================

model Product {
  id                String       @id @default(cuid())
  name              String
  slug              String
  description       String?      @db.Text
  type              ProductType  @default(PRODUCT)
  price             Decimal      @db.Decimal(10, 2)
  unitId            String
  categoryId        String?
  images            String[]     @default([])
  status            PublicationStatus @default(DRAFT)
  estimatedDuration String?
  isDemo            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  unit       Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  category   Category?    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
}

model Service {
  id            String   @id @default(cuid())
  name          String
  slug          String
  description   String?  @db.Text
  unitId        String
  priceFrom     Decimal? @db.Decimal(10, 2)
  duration      String?
  requirements  String?  @db.Text
  status        PublicationStatus @default(DRAFT)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  unitId      String?   // Null for global categories
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit     Unit?     @relation(fields: [unitId], references: [id])
  products Product[]
}

// ============================================
// PORTFOLIO & STUDENT WORKS
// ============================================

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  unitId      String
  category    String?
  images      String[] @default([])
  year        Int?
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model StudentWork {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  major       String?  // Jurusan
  unitId      String?
  studentTeam String?  @db.Text
  year        Int?
  images      String[] @default([])
  status      PublicationStatus @default(DRAFT)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit? @relation(fields: [unitId], references: [id])
}

// ============================================
// SHOPPING CART & ORDERS
// ============================================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  unitId    String?    // Cart is tied to one unit
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit  Unit?      @relation(fields: [unitId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  unitId    String
  quantity  Int      @default(1)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique // Human readable order ID
  userId          String
  unitId          String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String?     @db.Text
  notes           String?     @db.Text
  paymentMethod   String?
  paidAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  unit       Unit        @relation(fields: [unitId], references: [id])
  items      OrderItem[]
  payments   Payment[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  productType ProductType
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
  notes       String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  amount          Decimal  @db.Decimal(10, 2)
  method          String   // QRIS, TRANSFER, etc.
  status          String   // PENDING, SUCCESS, FAILED
  transactionId   String?
  paymentProof    String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?  // Home, Office, etc.
  fullName   String
  phone      String
  province   String
  city       String
  district   String
  postalCode String?
  address    String   @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
